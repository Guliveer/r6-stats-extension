{
  "manifest_version": 3,
  "name": "R6 Stats Extension",
  "version": "4.0.0",
  "description": "Quick links between tracker.gg and stats.cc + pinned players with current rank and ranked K/D",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "https://r6.tracker.network/*",
    "https://tracker.gg/r6siege/*",
    "https://stats.cc/*"
  ],
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://r6.tracker.network/r6siege/profile/*",
        "https://tracker.gg/r6siege/profile/*",
        "https://r6.tracker.network/r6siege/matches/*",
        "https://tracker.gg/r6siege/matches/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://stats.cc/siege/*"],
      "js": ["content-statscc.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/ranks/*", "icons/ranks/champion-ranks/*"],
      "matches": [
        "https://r6.tracker.network/*",
        "https://tracker.gg/*",
        "https://stats.cc/*"
      ]
    }
  ]
}
